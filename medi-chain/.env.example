# Environment Variables for MediChain Deployment

# Add your private key here (without 0x prefix)
# PRIVATE_KEY=your_private_key_here

# Add your Alchemy or Infura URL here
# ALCHEMY_URL=https://eth-sepolia.g.alchemy.com/v2/your_api_key_here

# Example:
# PRIVATE_KEY=1234567890abcdef1234567890abcdef1234567890abcdef1234567890abcdef
# ALCHEMY_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_API_KEY

# IMPORTANT: Never commit real private keys to version control!
# This file should be added to .gitignore
